{
  "schemaVersion": 1,
  "id": "seamless_crafting",
  "version": "${version}",
  "name": "Seamless Crafting",
  "description": "Craft directly from nearby containers with recipe-book support, item-safe returns, and container highlighting.",
  "authors": ["Derk Ottersberg"],
  "contact": {
    "sources": "https://github.com/DerkOttersberg/seamless-crafting",
    "issues": "https://github.com/DerkOttersberg/seamless-crafting/issues"
  },
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.derkottersberg.seamlesscrafting.fabric.SeamlessCraftingFabric"],
    "client": ["io.github.derkottersberg.seamlesscrafting.fabric.SeamlessCraftingFabricClient"],
    "jei_mod_plugin": ["io.github.derkottersberg.seamlesscrafting.fabric.SeamlessCraftingFabricJeiPlugin"]
  },
  "mixins": ["seamless_crafting.mixins.json"],
  "depends": {
    "fabricloader": "${fabric_loader_range}",
    "fabric-api": "${fabric_api_range}",
    "minecraft": "${minecraft_range}",
    "java": "${java_range}"
  }
}
